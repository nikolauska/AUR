pkgname=codebase-memory-mcp-bin
_pkgname=codebase-memory-mcp
pkgver=0.10.2
pkgrel=2
pkgdesc="High-performance code intelligence MCP server"
arch=('x86_64')
options=('!debug' '!strip')
url="https://github.com/DeusData/codebase-memory-mcp"
license=('MIT')
depends=('glibc' 'gcc-libs' 'zlib')
provides=('codebase-memory-mcp')
conflicts=('codebase-memory-mcp')

source=(
  "codebase-memory-mcp-${pkgver}-linux-amd64.tar.gz::https://github.com/DeusData/codebase-memory-mcp/releases/download/v${pkgver}/codebase-memory-mcp-linux-amd64.tar.gz"
  "$_pkgname.service"
)
sha256sums=(
  '6e3bb7353be21407a78e67b5465e53e3afb1a4a213e7a561606900ac08dcfdd6'
  '8f252589020ac6155ee6e4d236517599a1c0084fc2e6e93d079e0dee4be1ea08'
)

package() {
  cd "$srcdir"

  install -Dm755 "$_pkgname" "$pkgdir/usr/bin/$_pkgname"
  install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "THIRD_PARTY_NOTICES.md" "$pkgdir/usr/share/doc/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 "$srcdir/$_pkgname.service" "$pkgdir/usr/lib/systemd/user/$_pkgname.service"
}
