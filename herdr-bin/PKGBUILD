pkgname=herdr-bin
pkgver=0.9.1
pkgrel=1
pkgdesc="Terminal workspace manager for AI coding agents"
arch=('x86_64' 'aarch64')
options=('!debug' '!strip')
url="https://github.com/ogulcancelik/herdr"
license=('AGPL-3.0-or-later')
provides=('herdr')
conflicts=('herdr')

source=("LICENSE::https://raw.githubusercontent.com/ogulcancelik/herdr/v${pkgver}/LICENSE")
source_x86_64=("herdr-${pkgver}-x86_64::https://github.com/ogulcancelik/herdr/releases/download/v${pkgver}/herdr-linux-x86_64")
source_aarch64=("herdr-${pkgver}-aarch64::https://github.com/ogulcancelik/herdr/releases/download/v${pkgver}/herdr-linux-aarch64")
sha256sums=('a7fa24f74382fb3e4d320a608533a7c2999dbc0f780f1f734c8b891b31f0d9bd')
sha256sums_x86_64=('2a02fed16beb651ef006e1d43f048f652ca4dc58ad053cd2d44450563d5c54b7')
sha256sums_aarch64=('f4ccf4de745f2cb9a39a983e9ba3703dad50ec2a58dea83026ceab721bbd8d9e')

package() {
  install -Dm755 "$srcdir/herdr-${pkgver}-${CARCH}" "$pkgdir/usr/bin/herdr"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
