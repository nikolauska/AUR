pkgname=tasks-axi-bin
_pkgname=tasks-axi
pkgver=0.2.6
pkgrel=1
pkgdesc="AXI-compliant task/backlog CLI"
arch=('any')
url="https://github.com/kunchenguid/tasks-axi"
license=('MIT')
depends=('nodejs>=20')
makedepends=('npm')
provides=('tasks-axi')
conflicts=('tasks-axi')

source=("https://registry.npmjs.org/${_pkgname}/-/${_pkgname}-${pkgver}.tgz")
noextract=("${_pkgname}-${pkgver}.tgz")
sha512sums=('2c35d249807ec95c25a31ab55c6b5929e59a98e7ffa03f5716a9e884962516ba9a960e571277b54a919c359310a8dcd0b61b18fa2c8cbc251e1b13b3acbe7ff5')

package() {
  npm install -s -g \
    --cache "${srcdir}/npm-cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/${_pkgname}-${pkgver}.tgz"

  install -Dm644 \
    "${pkgdir}/usr/lib/node_modules/${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
