# Maintainer: Niko Lehtovirta <niko@lehtovirta.dev>

pkgname=tasks-axi-bin
_pkgname=tasks-axi
pkgver=0.2.5
pkgrel=1
pkgdesc="AXI-compliant task/backlog CLI"
arch=('any')
url="https://github.com/kunchenguid/tasks-axi"
license=('MIT')
depends=('nodejs>=20')
makedepends=('npm')
provides=('tasks-axi')
conflicts=('tasks-axi')

source=("https://registry.npmjs.org/${_pkgname}/-/${_pkgname}-${pkgver}.tgz")
noextract=("${_pkgname}-${pkgver}.tgz")
sha512sums=('171b2c116efe32e50d1d627bba1746ad1b010debff670e4dbad5011dc7fcaff9e91bacfdf8d7d450879775c7431eb0bd8b110a3aa43d52899acb64cba4307a12')

package() {
  npm install -s -g \
    --cache "${srcdir}/npm-cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/${_pkgname}-${pkgver}.tgz"

  install -Dm644 \
    "${pkgdir}/usr/lib/node_modules/${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
