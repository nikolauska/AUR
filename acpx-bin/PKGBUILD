# Maintainer: Niko Lehtovirta <niko@lehtovirta.dev>

pkgname=acpx-bin
_pkgname=acpx
pkgver=0.20.0
pkgrel=1
pkgdesc="Headless CLI client for stateful Agent Client Protocol sessions"
arch=('x86_64' 'aarch64')
options=('!debug' '!strip')
url="https://github.com/openclaw/acpx"
license=('MIT')
depends=('nodejs>=22.13.0')
makedepends=('npm')
provides=('acpx')
conflicts=('acpx')

source=("https://registry.npmjs.org/${_pkgname}/-/${_pkgname}-${pkgver}.tgz")
noextract=("${_pkgname}-${pkgver}.tgz")
sha512sums=('580d37338abe3b2211eebd4cad5371f3518e2f94f80d76685d1f8a2b712c7cc9818571745adcba65f113773ddc02acf4e10d66cfdc43f5ffa116fe8b53a0ca91')

package() {
  npm install -s -g \
    --cache "${srcdir}/npm-cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/${_pkgname}-${pkgver}.tgz"

  install -Dm644 \
    "${pkgdir}/usr/lib/node_modules/${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
