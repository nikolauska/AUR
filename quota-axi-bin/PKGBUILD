pkgname=quota-axi-bin
_pkgname=quota-axi
pkgver=0.1.68
pkgrel=1
pkgdesc="AXI CLI that reports local agent-provider quota windows"
arch=('any')
url="https://github.com/kunchenguid/quota-axi"
license=('MIT')
depends=('nodejs>=22.19')
makedepends=('npm')
provides=('quota-axi')
conflicts=('quota-axi')

source=("https://registry.npmjs.org/${_pkgname}/-/${_pkgname}-${pkgver}.tgz")
noextract=("${_pkgname}-${pkgver}.tgz")
sha512sums=('5eec410e7dc6df0ad55d55a206c6b7a5a2687d990b8cc20b3f54d5433c3dbe9c87c77c02a053f094431aa35f154da6f1b247c4a93646dfac2e96ecccd47f559b')

package() {
  npm install -s -g \
    --cache "${srcdir}/npm-cache" \
    --prefix "${pkgdir}/usr" \
    "${srcdir}/${_pkgname}-${pkgver}.tgz"

  install -Dm644 \
    "${pkgdir}/usr/lib/node_modules/${_pkgname}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
